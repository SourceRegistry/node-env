{
  "name": "@sourceregistry/node-env",
  "version": "1.5.0",
  "description": "A minimal, dependency-free TypeScript/JavaScript library for environment-variable loading and typed access.",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "jsr:check": "npx jsr publish --dry-run",
    "jsr:publish": "npx jsr publish",
    "lint": "tsc --noEmit",
    "verify": "npm run lint && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run verify",
    "docs:build": "typedoc src/index.ts --out docs --name \"node-env\" --theme default --excludePrivate --excludeProtected"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SourceRegistry/node-env.git"
  },
  "keywords": [
    "env",
    ".env",
    "environment",
    "typescript",
    "zero-dependency"
  ],
  "author": "A.P.A. Slaa (a.p.a.slaa@projectsource.nl)",
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SourceRegistry/node-env/issues"
  },
  "homepage": "https://github.com/SourceRegistry/node-env#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "node ./scripts/sync-jsr-version.mjs"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "jsr.json",
            "CHANGELOG.md"
          ],
          "message": "node-env(release): v${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
